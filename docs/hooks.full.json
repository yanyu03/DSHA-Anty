{
  "dsh-permissions": {
    "enabled": true,
    "PreToolUse": [
      {
        "matcher": ".*",
        "hooks": [
          {
            "type": "command",
            "command": "%DSHA_CONFIG_DIR%\\plugins\\dsh-permissions\\scripts\\run-gate.cmd",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "write_to_file|replace_file_content|create_file|apply_patch",
        "hooks": [
          {
            "type": "command",
            "command": "%DSHA_CONFIG_DIR%\\plugins\\dsh-permissions\\scripts\\englock.cmd",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
