# ==============================================================================
# DSHA-SharBoy Privacy & Build Artifacts Exclusion (.gitignore)
# ==============================================================================

# Python Caches and Virtual Environments
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
env/
venv/
.venv/
ENV/

# Node.js Dependencies and Package Caches
node_modules/
**/node_modules/
package-lock.json
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# DSHA Dedicated Pwsh Runtime Binary (fetch via scripts/fetch-pwsh.ps1)
bin/pwsh/
*.tgz
*.zip

# Antigravity Runtime & Session Rollbacks
.gemini/
_rollback/
*.bak
*._bak
*.tmp

# Logging & Audit Traces (Protect user privacy)
logs/*.log
logs/*.log.*
*.log
*.log.*
!plugins/dsh-permissions/logs/.gitkeep

# IDE and Editor Files
.vscode/
.idea/
*.swp
*~
*.suo
*.user

# Operating System Metadata
Thumbs.db
ehthumbs.db
Desktop.ini
.DS_Store

.local/
